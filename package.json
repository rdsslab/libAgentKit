{
  "name": "@rdsslab/agentkit",
  "version": "0.4.0",
  "description": "Provider-agnostic agent toolkit with Web GUI",
  "type": "module",
  "main": "packages/agentkit-core/src/index.js",
  "workspaces": [
    "packages/agentkit-core",
    "packages/agentkit-gui"
  ],
  "scripts": {
    "test": "node ./dev/test/index.js",
    "api": "node packages/agentkit-core/src/index.js",
    "agentkit": "node packages/agentkit-gui/server.js",
    "gui:dev": "vit dev -c packages/agentkit-gui",
    "gui:build": "vit build -c packages/agentkit-gui"
  },
  "keywords": [
    "agent",
    "ai",
    "harness",
    "llm",
    "mcp",
    "tools"
  ],
  "author": "rdsslab",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
