{
  "name": "@rdsslab/agentkit",
  "version": "0.4.0",
  "description": "Provider-agnostic agent toolkit: deterministic policies, web search, in-memory documents, media, file artifacts and a single askAgent() entry point.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ia": "./src/ia.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node ./dev/test/index.js",
    "test:kit": "node ./dev/test/agentkit_test.js",
    "test:artifacts": "node ./dev/test/artifacts_test.js",
    "test:terminal": "node ./dev/test/terminal_test.js",
    "test:mcp": "node ./dev/test/mcp_test.js",
    "tui": "node ./src/tui.js"
  },
  "keywords": [
    "agent",
    "agentkit",
    "harness",
    "llm",
    "mcp",
    "tools",
    "openai",
    "anthropic",
    "ollama"
  ],
  "author": "rdsslab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdsslab/libAgentKit.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@google/genai": "^1.36.0",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "ink": "^5.2.1",
    "ink-box": "^2.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^6.18.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1"
  }
}
