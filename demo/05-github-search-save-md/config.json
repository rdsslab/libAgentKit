{
  "provider": {
    "provider": "ollama",
    "baseUrl": "http://127.0.0.1:11434",
    "model": "qwen3:4b-instruct-8k",
    "timeout": 600000
  },
  "mode": "build",
  "interactive": true,
  "capabilities": {
    "terminal": true,
    "filesystem": false,
    "web": true,
    "mcp": false,
    "documents": true,
    "artifacts": false
  },
  "tools": {
    "run_command": true,
    "web_search": true,
    "write_file": "custom handler in run.mjs (writes to demo/05-github-search-save-md/output/)"
  },
  "terminal": {
    "allowedBinaries": ["curl", "cat", "echo"],
    "timeoutMs": 20000,
    "maxOutputBytes": 131072
  },
  "maxToolRounds": 6,
  "includeDiagnostics": true,
  "conversation": "2 steps/requests with history (step 1: search GitHub profile, step 2: save Markdown to disk)"
}
